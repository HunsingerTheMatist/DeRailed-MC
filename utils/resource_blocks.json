{
    "_comment": "Source of truth for mineable resource blocks. Run generate_resource_blocks.py to build the loot tables, blockstates, block tags and mined-block dispatch from this file. Nothing it generates should be hand-edited.",

    "hardness_families": {
        "_comment": "Every block a resource_block object may draw on, grouped by vanilla hardness. Mining time is ceil(hardness * 30 / speed), so tool speeds are solved per family from each resource type's stage_ticks. Blocks below the blank line are spare - nothing generates for a block until a resource_block object uses it.",
        "leaves": {
            "_comment": "A leaf carries four stage slots, persistent x waterlogged. Both properties hold still only because random_tick_speed is 0 - a persistent=false leaf with no log within six blocks is decaying, and decay calls dropResources, which would post a mined-block seed no player earned. A leaf is also a full collision block, so getShadeBrightness returns 0.2 and it darkens whatever sits beside it, which is why only the first two stages use one.",
            "hardness": 0.2,
            "blocks": [
                "acacia_leaves",
                "azalea_leaves",
                "cherry_leaves",
                "oak_leaves",

                "birch_leaves",
                "dark_oak_leaves",
                "flowering_azalea_leaves",
                "jungle_leaves",
                "mangrove_leaves",
                "pale_oak_leaves",
                "spruce_leaves"
            ]
        },
        "glass": {
            "_comment": "TransparentBlock overrides getShadeBrightness to 1.0, so unlike a leaf these never darken a neighbour. No usable state property, so one id is one stage slot. tinted_glass shares the 0.3 hardness but blocks light at opacity 15 where the rest are 0, so it is not a drop-in.",
            "hardness": 0.3,
            "blocks": [
                "black_stained_glass",
                "blue_stained_glass",
                "brown_stained_glass",
                "cyan_stained_glass",
                "gray_stained_glass",
                "green_stained_glass",
                "light_blue_stained_glass",
                "light_gray_stained_glass",
                "lime_stained_glass",
                "magenta_stained_glass",
                "orange_stained_glass",
                "pink_stained_glass",

                "purple_stained_glass",
                "red_stained_glass",
                "white_stained_glass",
                "yellow_stained_glass",
                "glass",
                "tinted_glass"
            ]
        },
        "copper": {
            "_comment": "All hardness 3. copper_block and cut_copper are opaque, so a stage on one has to fill its whole cube or the blocks around it lose their faces and the world shows through - fine for the full-cube early stages. copper_grate is noOcclusion and a WaterloggedTransparentBlock, so it neither occludes nor darkens, and its waterlogged property gives each id two stage slots. Oxidation is a random tick, so the unwaxed variants hold still only while random_tick_speed is 0.",
            "hardness": 3,
            "blocks": [
                "copper_block",
                "cut_copper",
                "copper_grate",

                "exposed_copper_block",
                "weathered_copper_block",
                "oxidized_copper_block",
                "waxed_copper_block",
                "waxed_exposed_copper_block",
                "waxed_weathered_copper_block",
                "waxed_oxidized_copper_block",
                "exposed_cut_copper",
                "weathered_cut_copper",
                "oxidized_cut_copper",
                "waxed_cut_copper",
                "waxed_exposed_cut_copper",
                "waxed_weathered_cut_copper",
                "waxed_oxidized_cut_copper",
                "exposed_copper_grate",
                "weathered_copper_grate",
                "oxidized_copper_grate",
                "waxed_copper_grate",
                "waxed_exposed_copper_grate",
                "waxed_weathered_copper_grate",
                "waxed_oxidized_copper_grate"
            ]
        }
    },

    "resource_types": {
        "_comment": "category names the folder this resource's block tags and models live under, so the two cannot drift apart.",
        "wood": {
