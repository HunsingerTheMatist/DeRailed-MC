
# Clears the barriers over the block the back of the train has just come onto,
#  which it no longer covers all of, and moves the back trail onto it
# Positioned at the middle of the block the back of the train is on

fill ~ ~0.8 ~ ~ ~1.8 ~ air replace pink_stained_glass_pane strict
tp @n[type=marker,tag=dr_trail_back,distance=0..] ~ ~ ~
