
# Reports how often sections needed their terrain rerolled since the counts were
#  last cleared, and which check turned them away

# A run that is being timed says nothing: a few hundred maps worth of this is a
#  few thousand lines of chat, which costs the client enough to muddy what the
#  profiler has to say about it
execute if score #gen_report dr_var matches 0 run return 0

tellraw @a [{text:"[gen] rerolls: ",color:"gray"},{score:{name:"#gen_rerolls",objective:"dr_var"}},{text:"   no way across: "},{score:{name:"#gen_fail_path",objective:"dr_var"}},{text:"   too cheap: "},{score:{name:"#gen_fail_cheap",objective:"dr_var"}},{text:"   too expensive: "},{score:{name:"#gen_fail_costly",objective:"dr_var"}},{text:"   too open: "},{score:{name:"#gen_fail_flat",objective:"dr_var"}},{text:"   no second way: "},{score:{name:"#gen_fail_second",objective:"dr_var"}},{text:"   windows wanting: "},{score:{name:"#gen_fail_windows",objective:"dr_var"}},{text:"   cheaper once cut: "},{score:{name:"#gen_fail_shortcut",objective:"dr_var"}},{text:"   wood out of order: "},{score:{name:"#gen_fail_order",objective:"dr_var"}},{text:"   water too far: "},{score:{name:"#gen_fail_water",objective:"dr_var"}},{text:"   started afresh: "},{score:{name:"#gen_fresh_total",objective:"dr_var"}},{text:"   gave up on: "},{score:{name:"#gen_failed",objective:"dr_var"}},{text:"   loosened as a last resort: "},{score:{name:"#gen_lenient_sections",objective:"dr_var"}},{text:"   floods stopped for getting out: "},{score:{name:"#gen_leaks",objective:"dr_var"}}]
tellraw @a [{text:"[gen] last section: ",color:"gray"},{score:{name:"#gen_wood",objective:"dr_var"}},{text:" wood seeds, "},{score:{name:"#gen_iron",objective:"dr_var"}},{text:" iron seeds, route "},{score:{name:"#gen_route",objective:"dr_var"}},{text:" tiles costing "},{score:{name:"#gen_cost",objective:"dr_var"}},{text:", which is "},{score:{name:"#gen_rate_raw",objective:"dr_var"}},{text:" a rail and "},{score:{name:"#gen_rate",objective:"dr_var"}},{text:" with the length counted, in hundredths, cutting "},{score:{name:"#gen_carved",objective:"dr_var"}},{text:" rock tiles, pinch "},{score:{name:"#gen_pinch",objective:"dr_var"}},{text:" after opening "},{score:{name:"#gen_opened",objective:"dr_var"}}]

# The average is worked out here rather than kept, since a running one would
#  drift with every rounding
scoreboard players operation #gen_rate_avg dr_var = #gen_rate_sum dr_var
execute if score #gen_rate_n dr_var matches 1.. run scoreboard players operation #gen_rate_avg dr_var /= #gen_rate_n dr_var
tellraw @a [{text:"[gen] tier ",color:"gray"},{score:{name:"#gen_difficulty",objective:"dr_var"}},{text:", bounds "},{score:{name:"#gen_rate_min",objective:"dr_var"}},{text:" to "},{score:{name:"#gen_rate_max",objective:"dr_var"}},{text:" a rail   over "},{score:{name:"#gen_rate_n",objective:"dr_var"}},{text:" attempts: lowest "},{score:{name:"#gen_rate_lo",objective:"dr_var"}},{text:", highest "},{score:{name:"#gen_rate_hi",objective:"dr_var"}},{text:", average "},{score:{name:"#gen_rate_avg",objective:"dr_var"}}]
tellraw @a [{text:"[gen] last rivers: ",color:"gray"},{score:{name:"#riv_first",objective:"dr_var"}},{text:" and "},{score:{name:"#riv_second",objective:"dr_var"}},{text:" tiles, the second held to "},{score:{name:"#riv_need",objective:"dr_var"}}]
tellraw @a [{text:"[gen] last seam: ",color:"gray"},{score:{name:"#seam_rows",objective:"dr_var"}},{text:" of 16 rows carried over, as "},{score:{name:"#seam_n",objective:"dr_var"}},{text:" regions   notes found: "},{score:{name:"#seam_seen",objective:"dr_var"}},{text:", of those with a kind: "},{score:{name:"#seam_ok",objective:"dr_var"}},{text:"   waiting on a later wave: "},{score:{name:"#seam_late",objective:"dr_var"}},{text:", of those lost: "},{score:{name:"#seam_lost",objective:"dr_var"}}]
tellraw @a [{text:"[gen] the second river's search: ",color:"gray"},{score:{name:"#riv_dead",objective:"dr_var"}},{text:" tiles written off, "},{score:{name:"#riv_steps",objective:"dr_var"}},{text:" steps left, "},{score:{name:"#riv_tries",objective:"dr_var"}},{text:" starts left"}]
tellraw @a [{text:"[gen] rivers not laid at all: ",color:"gray"},{score:{name:"#gen_no_river",objective:"dr_var"}},{text:"   fell back to their longest: "},{score:{name:"#riv_fell",objective:"dr_var"}},{text:"   ending in a lake: "},{score:{name:"#riv_lakes",objective:"dr_var"}},{text:"   no region for a lake: "},{score:{name:"#riv_dry",objective:"dr_var"}},{text:"   second rivers ending in the first: "},{score:{name:"#riv_joins",objective:"dr_var"}},{text:"   loops cut out: "},{score:{name:"#riv_cuts",objective:"dr_var"}},{text:"   lines refused for a prefab: "},{score:{name:"#riv_refused",objective:"dr_var"}},{text:"   strays handed on: "},{score:{name:"#gen_strays",objective:"dr_var"}},"   river tiles taken into a lake: ",{score:{name:"#gen_lakeside",objective:"dr_var"}}]

# The cutting gets a line of its own, with each count green for none and red
#  for any; a colour is fixed on a text component, so the line exists once for
#  each way the two counts can fall and one prints
# How many hard sections were left with a hole in their wall rides on the end
execute if score #gen_cuts dr_var matches 0 if score #gen_relieved dr_var matches 0 run tellraw @a [{text:"[gen] sections that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts",objective:"dr_var"},color:"green"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved",objective:"dr_var"},color:"green"},{text:"   walls left with a hole: "},{score:{name:"#gen_wall_gaps",objective:"dr_var"}},{text:", too big: "},{score:{name:"#gen_wall_big",objective:"dr_var"}},{text:", laid again: "},{score:{name:"#gen_wall_relaid",objective:"dr_var"}}]
execute if score #gen_cuts dr_var matches 0 if score #gen_relieved dr_var matches 1.. run tellraw @a [{text:"[gen] sections that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts",objective:"dr_var"},color:"green"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved",objective:"dr_var"},color:"red"},{text:"   walls left with a hole: "},{score:{name:"#gen_wall_gaps",objective:"dr_var"}},{text:", too big: "},{score:{name:"#gen_wall_big",objective:"dr_var"}},{text:", laid again: "},{score:{name:"#gen_wall_relaid",objective:"dr_var"}}]
execute if score #gen_cuts dr_var matches 1.. if score #gen_relieved dr_var matches 0 run tellraw @a [{text:"[gen] sections that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts",objective:"dr_var"},color:"red"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved",objective:"dr_var"},color:"green"},{text:"   walls left with a hole: "},{score:{name:"#gen_wall_gaps",objective:"dr_var"}},{text:", too big: "},{score:{name:"#gen_wall_big",objective:"dr_var"}},{text:", laid again: "},{score:{name:"#gen_wall_relaid",objective:"dr_var"}}]
execute if score #gen_cuts dr_var matches 1.. if score #gen_relieved dr_var matches 1.. run tellraw @a [{text:"[gen] sections that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts",objective:"dr_var"},color:"red"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved",objective:"dr_var"},color:"red"},{text:"   walls left with a hole: "},{score:{name:"#gen_wall_gaps",objective:"dr_var"}},{text:", too big: "},{score:{name:"#gen_wall_big",objective:"dr_var"}},{text:", laid again: "},{score:{name:"#gen_wall_relaid",objective:"dr_var"}}]

# The second route's cutting gets the same line, with how many sections found
#  no second way across at all on the end
execute if score #gen_cuts2 dr_var matches 0 if score #gen_relieved2 dr_var matches 0 run tellraw @a [{text:"[gen] second routes that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts2",objective:"dr_var"},color:"green"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved2",objective:"dr_var"},color:"green"},{text:"   none found: "},{score:{name:"#gen_no_second",objective:"dr_var"}},{text:"   ends opened for one: "},{score:{name:"#gen_ends_opened",objective:"dr_var"}}]
execute if score #gen_cuts2 dr_var matches 0 if score #gen_relieved2 dr_var matches 1.. run tellraw @a [{text:"[gen] second routes that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts2",objective:"dr_var"},color:"green"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved2",objective:"dr_var"},color:"red"},{text:"   none found: "},{score:{name:"#gen_no_second",objective:"dr_var"}},{text:"   ends opened for one: "},{score:{name:"#gen_ends_opened",objective:"dr_var"}}]
execute if score #gen_cuts2 dr_var matches 1.. if score #gen_relieved2 dr_var matches 0 run tellraw @a [{text:"[gen] second routes that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts2",objective:"dr_var"},color:"red"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved2",objective:"dr_var"},color:"green"},{text:"   none found: "},{score:{name:"#gen_no_second",objective:"dr_var"}},{text:"   ends opened for one: "},{score:{name:"#gen_ends_opened",objective:"dr_var"}}]
execute if score #gen_cuts2 dr_var matches 1.. if score #gen_relieved2 dr_var matches 1.. run tellraw @a [{text:"[gen] second routes that cut through rock: ",color:"gray"},{score:{name:"#gen_cuts2",objective:"dr_var"},color:"red"},{text:"   opened up for pinching: "},{score:{name:"#gen_relieved2",objective:"dr_var"},color:"red"},{text:"   none found: "},{score:{name:"#gen_no_second",objective:"dr_var"}},{text:"   ends opened for one: "},{score:{name:"#gen_ends_opened",objective:"dr_var"}}]

# The supply gets a line, with the count of sections still short in red
execute if score #gen_supply_short dr_var matches 0 run tellraw @a [{text:"[gen] sections short of wood or iron after repainting: ",color:"gray"},{score:{name:"#gen_supply_short",objective:"dr_var"},color:"green"},{text:"   swaps by the repair: "},{score:{name:"#gen_repair_swaps_total",objective:"dr_var"}},{text:", repaints: "},{score:{name:"#gen_repair_paints_total",objective:"dr_var"}},{text:"   windows left wanting: "},{score:{name:"#gen_spread_total",objective:"dr_var"}},{text:"   tails left wanting: "},{score:{name:"#gen_tail_gaps",objective:"dr_var"}}]
execute if score #gen_supply_short dr_var matches 1.. run tellraw @a [{text:"[gen] sections short of wood or iron after repainting: ",color:"gray"},{score:{name:"#gen_supply_short",objective:"dr_var"},color:"red"},{text:"   swaps by the repair: "},{score:{name:"#gen_repair_swaps_total",objective:"dr_var"}},{text:", repaints: "},{score:{name:"#gen_repair_paints_total",objective:"dr_var"}},{text:"   windows left wanting: "},{score:{name:"#gen_spread_total",objective:"dr_var"}},{text:"   tails left wanting: "},{score:{name:"#gen_tail_gaps",objective:"dr_var"}}]

# And the pieces, how many were placed and how many the players could not get
#  to and were dropped
tellraw @a [{text:"[gen] pieces placed: ",color:"gray"},{score:{name:"#gen_pieces_placed",objective:"dr_var"}},{text:"   dropped out of reach: "},{score:{name:"#gen_pieces_dropped",objective:"dr_var"}}]

# And how many regions were repainted as wood to get the players their wood in
#  order
tellraw @a [{text:"[gen] regions repainted as wood for the order: ",color:"gray"},{score:{name:"#gen_order_fixed",objective:"dr_var"}}]
