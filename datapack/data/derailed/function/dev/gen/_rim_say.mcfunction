
# Prints what the tiles of zone $(z), the section's $(n) ten columns, were
#  counted as

$tellraw @a [{text:"[gen]   $(n) ten columns: rock ",color:"gray"},{score:{name:"#$(z)_rock",objective:"dr_rim"}},{text:", river "},{score:{name:"#$(z)_river",objective:"dr_rim"}},{text:"; first route's regions g/w/i/a "},{score:{name:"#$(z)_fg",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_fw",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_fi",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_fa",objective:"dr_rim"}},{text:"; its other regions "},{score:{name:"#$(z)_og",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_ow",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_oi",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_oa",objective:"dr_rim"}},{text:"; not its own "},{score:{name:"#$(z)_xg",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_xw",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_xi",objective:"dr_rim"}},{text:"/"},{score:{name:"#$(z)_xa",objective:"dr_rim"}},{text:"; other "},{score:{name:"#$(z)_etc",objective:"dr_rim"}}]
