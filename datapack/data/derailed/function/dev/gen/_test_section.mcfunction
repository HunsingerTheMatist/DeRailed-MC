
# Builds the next section on the tier already set, and says what its route cost
#  a rail against the tier's bounds and what it cut
# A run being timed says nothing, the same as the report
# The cutting gets a line of its own, with each count green for none and red
#  for any; a colour is fixed on a text component, so that line exists once for
#  each way the two counts can fall and one prints

function derailed:dev/gen/next_section

execute if score #gen_report dr_var matches 1 run tellraw @a [{text:"[gen] section ",color:"gray"},{score:{name:"#gen_section",objective:"dr_var"}},{text:" on tier "},{score:{name:"#gen_difficulty",objective:"dr_var"}},{text:": cost "},{score:{name:"#gen_cost",objective:"dr_var"}},{text:" over "},{score:{name:"#gen_route",objective:"dr_var"}},{text:" rails, "},{score:{name:"#gen_rate_raw",objective:"dr_var"}},{text:" a rail, "},{score:{name:"#gen_rate",objective:"dr_var"}},{text:" with the length counted, against "},{score:{name:"#gen_rate_min",objective:"dr_var"}},{text:" to "},{score:{name:"#gen_rate_max",objective:"dr_var"}},{text:", pinch "},{score:{name:"#gen_pinch",objective:"dr_var"}},{text:" against "},{score:{name:"#gen_pinch_min",objective:"dr_var"}},{text:" to "},{score:{name:"#gen_pinch_max",objective:"dr_var"}},{text:", valid "},{score:{name:"#gen_valid",objective:"dr_var"}},{text:", strays "},{score:{name:"#stray_n",objective:"dr_var"}}]

execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 0 if score #gen_opened dr_var matches 0 run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 0 if score #gen_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 1.. if score #gen_opened dr_var matches 0 run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 1.. if score #gen_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]

# The second route gets a line of the same shape
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 0 run tellraw @a [{text:"[gen]   no second route found",color:"gray"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 0 if score #sec_opened dr_var matches 0 run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" off the first route, longest detour "},{score:{name:"#sec_detour",objective:"dr_var"}},{text:", pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 0 if score #sec_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" off the first route, longest detour "},{score:{name:"#sec_detour",objective:"dr_var"}},{text:", pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 1.. if score #sec_opened dr_var matches 0 run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" off the first route, longest detour "},{score:{name:"#sec_detour",objective:"dr_var"}},{text:", pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 1.. if score #sec_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" off the first route, longest detour "},{score:{name:"#sec_detour",objective:"dr_var"}},{text:", pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]

# What each route costs to lay, and the cheapest way across once both have cut
#  what they cut, red where that falls outside the band
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #true_ok dr_var matches 1 run tellraw @a [{text:"[gen]   route costs: first ",color:"gray"},{score:{name:"#price_first",objective:"dr_var"}},{text:", second "},{score:{name:"#price_second",objective:"dr_var"}},{text:", cheapest once both are cut "},{score:{name:"#true_cost",objective:"dr_var"},color:"green"},{text:" over "},{score:{name:"#true_route",objective:"dr_var"}},{text:" rails, "},{score:{name:"#true_rate",objective:"dr_var"},color:"green"},{text:" a rail with the length counted"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #true_ok dr_var matches 0 run tellraw @a [{text:"[gen]   route costs: first ",color:"gray"},{score:{name:"#price_first",objective:"dr_var"}},{text:", second "},{score:{name:"#price_second",objective:"dr_var"}},{text:", cheapest once both are cut "},{score:{name:"#true_cost",objective:"dr_var"},color:"red"},{text:" over "},{score:{name:"#true_route",objective:"dr_var"}},{text:" rails, "},{score:{name:"#true_rate",objective:"dr_var"},color:"red"},{text:" a rail with the length counted"}]

# How far the players get taking their wood in order, the level every tile of
#  the first route needs, and the wood and iron they reach against what the
#  routes need, red where it falls short
execute if score #gen_report dr_var matches 1 if score #order_ran dr_var matches 1 if score #order_ok dr_var matches 1 run tellraw @a [{text:"[gen]   order: levels reached ",color:"gray"},{score:{name:"#oL",objective:"dr_var"}},{text:" of "},{score:{name:"#omax",objective:"dr_var"}},{text:", the route needs "},{score:{name:"#ormax",objective:"dr_var"}},{text:", wood "},{score:{name:"#oW",objective:"dr_var"}},{text:" of "},{score:{name:"#need_wood",objective:"dr_var"}},{text:", iron "},{score:{name:"#oI",objective:"dr_var"}},{text:" of "},{score:{name:"#need_iron",objective:"dr_var"}},{text:" reached in order",color:"green"}]
execute if score #gen_report dr_var matches 1 if score #order_ran dr_var matches 1 if score #order_ok dr_var matches 0 run tellraw @a [{text:"[gen]   order: levels reached ",color:"gray"},{score:{name:"#oL",objective:"dr_var"}},{text:" of "},{score:{name:"#omax",objective:"dr_var"}},{text:", the route needs "},{score:{name:"#ormax",objective:"dr_var"}},{text:", wood "},{score:{name:"#oW",objective:"dr_var"}},{text:" of "},{score:{name:"#need_wood",objective:"dr_var"}},{text:", iron "},{score:{name:"#oI",objective:"dr_var"}},{text:" of "},{score:{name:"#need_iron",objective:"dr_var"}},{text:" reached in order",color:"red"}]

# How many tiles of the cheapest way across are too far from water, green for
#  none and red for any
execute if score #gen_report dr_var matches 1 if score #water_far dr_var matches 0 run tellraw @a [{text:"[gen]   water: all ",color:"gray"},{score:{name:"#water_path",objective:"dr_var"}},{text:" tiles of the cheapest way within "},{score:{name:"#gen_water_reach",objective:"dr_var"}},{text:" steps of it",color:"green"}]
execute if score #gen_report dr_var matches 1 if score #water_far dr_var matches 1.. run tellraw @a [{text:"[gen]   water: ",color:"gray"},{score:{name:"#water_far",objective:"dr_var"},color:"red"},{text:" of "},{score:{name:"#water_path",objective:"dr_var"}},{text:" tiles of the cheapest way further than "},{score:{name:"#gen_water_reach",objective:"dr_var"}},{text:" steps from it"}]

# Which pieces the section got, and how many of them were dropped for being out
#  of the players' reach
execute if score #gen_report dr_var matches 1 run tellraw @a [{text:"[gen]   pieces: cows ",color:"gray"},{score:{name:"#piece_cows",objective:"dr_var"}},{text:", bandits "},{score:{name:"#piece_bandits",objective:"dr_var"}},{text:", dropped out of reach "},{score:{name:"#piece_lost",objective:"dr_var"}}]

# And the supply, green where the section holds enough and red where it does
#  not
execute if score #gen_report dr_var matches 1 if score #sup_short dr_var matches 0 run tellraw @a [{text:"[gen]   supply: wood ",color:"gray"},{score:{name:"#sup_wood",objective:"dr_var"},color:"green"},{text:" of "},{score:{name:"#need_wood",objective:"dr_var"}},{text:", iron "},{score:{name:"#sup_iron",objective:"dr_var"},color:"green"},{text:" of "},{score:{name:"#need_iron",objective:"dr_var"}},{text:" within reach, "},{score:{name:"#sup_bridges",objective:"dr_var"}},{text:" bridges on the way, "},{score:{name:"#gen_repair_swaps",objective:"dr_var"}},{text:" swaps and "},{score:{name:"#gen_repair_paints",objective:"dr_var"}},{text:" repaints by the repair, shortfall left "},{score:{name:"#gen_repair_left",objective:"dr_var"}},{text:", "},{score:{name:"#gen_spread_gaps",objective:"dr_var"}},{text:" windows wanting"}]
execute if score #gen_report dr_var matches 1 if score #sup_short dr_var matches 1 run tellraw @a [{text:"[gen]   supply: wood ",color:"gray"},{score:{name:"#sup_wood",objective:"dr_var"},color:"red"},{text:" of "},{score:{name:"#need_wood",objective:"dr_var"}},{text:", iron "},{score:{name:"#sup_iron",objective:"dr_var"},color:"red"},{text:" of "},{score:{name:"#need_iron",objective:"dr_var"}},{text:" within reach, "},{score:{name:"#sup_bridges",objective:"dr_var"}},{text:" bridges on the way, "},{score:{name:"#gen_repair_swaps",objective:"dr_var"}},{text:" swaps and "},{score:{name:"#gen_repair_paints",objective:"dr_var"}},{text:" repaints by the repair, shortfall left "},{score:{name:"#gen_repair_left",objective:"dr_var"}},{text:", "},{score:{name:"#gen_spread_gaps",objective:"dr_var"}},{text:" windows wanting"}]

# Where windows are left wanting, which they are, by the column of this section
#  each ends on, and the columns fed through them, the section before's first
execute if score #gen_report dr_var matches 1 if score #gen_spread_gaps dr_var matches 1.. run tellraw @a [{text:"[gen]   windows wanting, each of ",color:"gray"},{score:{name:"#gen_spread_need",objective:"dr_var"}},{text:" wood and iron: "},{nbt:"spread_gaps",storage:"derailed:gen"}]
execute if score #gen_report dr_var matches 1 if score #gen_spread_gaps dr_var matches 1.. run tellraw @a [{text:"[gen]   columns through them: ",color:"gray"},{nbt:"spread_cols",storage:"derailed:gen"}]
execute if score #gen_report dr_var matches 1 if score #gen_spread_gaps dr_var matches 1.. if score #gen_section dr_var matches 2.. run function derailed:dev/gen/_rim_say {z:p,n:"the section before's last"}
execute if score #gen_report dr_var matches 1 if score #gen_spread_gaps dr_var matches 1.. run function derailed:dev/gen/_rim_say {z:a,n:"its first"}

# And the regions as the kinds were drawn, before any repainting
execute if score #gen_report dr_var matches 1 run tellraw @a [{text:"[gen]   regions: ",color:"gray"},{score:{name:"#sup_rock_n",objective:"dr_var"}},{text:" rock ("},{score:{name:"#sup_wall_n",objective:"dr_var"}},{text:" wall), wood "},{score:{name:"#sup_wood_n",objective:"dr_var"}},{text:" with "},{score:{name:"#sup_wood_r",objective:"dr_var"}},{text:" in reach, iron "},{score:{name:"#sup_iron_n",objective:"dr_var"}},{text:" with "},{score:{name:"#sup_iron_r",objective:"dr_var"}},{text:" in reach, tail wanting: "},{score:{name:"#gen_tail_gap",objective:"dr_var"}},{text:", repair saw wood "},{score:{name:"#rep_tw",objective:"dr_var"}},{text:" iron "},{score:{name:"#rep_ti",objective:"dr_var"}}]
