
# Builds the next section on the tier already set, and says what its route cost
#  a rail against the tier's bounds and what it cut
# A run being timed says nothing, the same as the report
# The cutting gets a line of its own, with each count green for none and red
#  for any; a colour is fixed on a text component, so that line exists once for
#  each way the two counts can fall and one prints

function derailed:dev/gen/next_section

execute if score #gen_report dr_var matches 1 run tellraw @a [{text:"[gen] section ",color:"gray"},{score:{name:"#gen_section",objective:"dr_var"}},{text:" on tier "},{score:{name:"#gen_difficulty",objective:"dr_var"}},{text:": cost "},{score:{name:"#gen_cost",objective:"dr_var"}},{text:" over "},{score:{name:"#gen_route",objective:"dr_var"}},{text:" rails, "},{score:{name:"#gen_rate_raw",objective:"dr_var"}},{text:" a rail, "},{score:{name:"#gen_rate",objective:"dr_var"}},{text:" with the length counted, against "},{score:{name:"#gen_rate_min",objective:"dr_var"}},{text:" to "},{score:{name:"#gen_rate_max",objective:"dr_var"}},{text:", pinch "},{score:{name:"#gen_pinch",objective:"dr_var"}},{text:" against "},{score:{name:"#gen_pinch_min",objective:"dr_var"}},{text:" to "},{score:{name:"#gen_pinch_max",objective:"dr_var"}},{text:", valid "},{score:{name:"#gen_valid",objective:"dr_var"}},{text:", strays "},{score:{name:"#stray_n",objective:"dr_var"}}]

execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 0 if score #gen_opened dr_var matches 0 run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 0 if score #gen_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 1.. if score #gen_opened dr_var matches 0 run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #gen_carved dr_var matches 1.. if score #gen_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   cut ",color:"gray"},{score:{name:"#gen_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for the route and "},{score:{name:"#gen_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]

# The second route gets a line of the same shape
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 0 run tellraw @a [{text:"[gen]   no second route found",color:"gray"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 0 if score #sec_opened dr_var matches 0 run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" astray from the first, pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 0 if score #sec_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" astray from the first, pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"green"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 1.. if score #sec_opened dr_var matches 0 run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" astray from the first, pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"green"},{text:" for pinching"}]
execute if score #gen_report dr_var matches 1 if score #sec_reached dr_var matches 1 if score #sec_carved dr_var matches 1.. if score #sec_opened dr_var matches 1.. run tellraw @a [{text:"[gen]   second route ",color:"gray"},{score:{name:"#sec_route",objective:"dr_var"}},{text:" tiles, "},{score:{name:"#sec_astray",objective:"dr_var"}},{text:" astray from the first, pinch "},{score:{name:"#sec_pinch",objective:"dr_var"}},{text:", cut "},{score:{name:"#sec_carved",objective:"dr_var"},color:"red"},{text:" rock tiles for it and "},{score:{name:"#sec_opened",objective:"dr_var"},color:"red"},{text:" for pinching"}]
