
# Clears every tile still due to spread, whichever of the eight waves it was on
# A tile carries only the tag of its wave, since a second tag on each of seven
#  hundred a section costs more than eight sweeps at the odd time this is wanted

kill @e[type=marker,tag=dr_w0,distance=0..]
kill @e[type=marker,tag=dr_w1,distance=0..]
kill @e[type=marker,tag=dr_w2,distance=0..]
kill @e[type=marker,tag=dr_w3,distance=0..]
kill @e[type=marker,tag=dr_w4,distance=0..]
kill @e[type=marker,tag=dr_w5,distance=0..]
kill @e[type=marker,tag=dr_w6,distance=0..]
kill @e[type=marker,tag=dr_w7,distance=0..]
