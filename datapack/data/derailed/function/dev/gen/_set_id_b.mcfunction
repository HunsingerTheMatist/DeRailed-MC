
# Places the block for the region held in '#gen_id', for regions 8 to 15

execute if score #gen_id dr_var matches 8 run return run setblock ~ ~ ~ light_gray_terracotta strict
execute if score #gen_id dr_var matches 9 run return run setblock ~ ~ ~ cyan_terracotta strict
execute if score #gen_id dr_var matches 10 run return run setblock ~ ~ ~ purple_terracotta strict
execute if score #gen_id dr_var matches 11 run return run setblock ~ ~ ~ blue_terracotta strict
execute if score #gen_id dr_var matches 12 run return run setblock ~ ~ ~ green_terracotta strict
execute if score #gen_id dr_var matches 13 run return run setblock ~ ~ ~ red_terracotta strict
execute if score #gen_id dr_var matches 14 run return run setblock ~ ~ ~ black_terracotta strict
execute if score #gen_id dr_var matches 15 run return run setblock ~ ~ ~ brown_terracotta strict
